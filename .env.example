# 复制为 .env 后填写。密钥和证书只放本机，不要发到聊天、不要提交到仓库。

# 顾客打开的站点根地址，必须是 https，且不能带路径。
# 例：https://order.example.com
PUBLIC_BASE_URL=

# 服务号（必须已认证）。AppSecret 在公众平台 → 设置与开发 → 基本配置。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 微信支付商户号，以及商户 API 证书序列号（不是证书文件内容）。
WECHAT_MCH_ID=
WECHAT_MCH_CERT_SERIAL=

# 下面两个是文件路径，相对仓库根目录。把 pem 放进 secrets/。
WECHAT_MCH_PRIVATE_KEY_PATH=secrets/apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_PATH=secrets/wxp_pub.pem

# 32 位 APIv3 密钥，以及微信支付公钥 ID（形如 PUB_KEY_ID_...）。
WECHAT_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=

# 商家后台账号。密码至少 8 位。
MERCHANT_USERNAME=admin
MERCHANT_PASSWORD=

# 随便一长串随机字符，用来签登录 cookie。至少 16 位。
SESSION_SECRET=

SHOP_NAME=本店
PAY_TIMEOUT_MINUTES=15
PORT=3000
DATA_DIR=data
